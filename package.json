{
  "name": "fundisha-backend",
  "version": "1.1.0",
  "description": "Express + PostgreSQL API for Fundisha, a skills-tutoring marketplace",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:seed:demo": "node src/db/seed.js --demo",
    "db:reset-demo": "node src/db/seed.js --reset-demo",
    "db:setup": "node src/db/migrate.js && node src/db/seed.js --demo",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "keywords": [],
  "author": "Omarfarouq Ahmed Hassan",
  "license": "ISC",
  "dependencies": {
    "@vercel/functions": "^3.10.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "zod": "$zod"
  }
}
