# --- Required ---
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/fundisha
# At least 32 random characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# --- Server ---
PORT=4000
NODE_ENV=development
# Used only by `npm test`. The tests wipe this database, so its name must contain "test".
# Create it once with: createdb fundisha_test
TEST_DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/fundisha_test

# Comma-separated frontend origins allowed to call this API. * matches one URL segment, e.g.
# https://fundisha-frontend-*-youruser.vercel.app allows Vercel preview deployments
CORS_ORIGIN=http://localhost:5173
# Set to true when your hosted Postgres requires SSL (most do for external connections)
DATABASE_SSL=false
# Connections per instance. The default is 10 locally and 5 on Vercel
# DB_POOL_MAX=5

# --- Links inside emails and the M-Pesa callback ---
APP_URL=http://localhost:5173
# Must be a public HTTPS URL for M-Pesa callbacks to reach you (use a tunnel such as ngrok locally)
API_URL=http://localhost:4000

# --- Email (Resend, resend.com). Without a key, emails are logged and skipped ---
RESEND_API_KEY=
FROM_EMAIL=Fundisha <onboarding@resend.dev>
# true = users must verify their email before booking or publishing a profile
REQUIRE_VERIFIED_EMAIL=false

# --- M-Pesa Daraja (developer.safaricom.co.ke). Sandbox by default ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
# Leave empty in the sandbox to use Safaricom's published test passkey
MPESA_PASSKEY=
# Random string that becomes part of the callback URL so only Safaricom's request is accepted
MPESA_CALLBACK_SECRET=replace-with-another-long-random-string
